# Local development only. Production reads the same keys from the Kubernetes
# Secret named discord-ai-agent-env. Stable product settings live in
# src/config/env.ts and are reviewed like any other code change.

# Required application credentials and identity
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATABASE_URL=postgres://discord_ai_agent:discord_ai_agent@localhost:5433/discord_ai_agent
OPENROUTER_API_KEY=
TASK_SIGNING_SECRET=

# GitHub: use a token locally, or all three GitHub App credentials in production
GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# Operator access and protected capabilities
CONTROL_UI_AUTH_PASSWORD=
# CONTROL_UI_PUBLIC_URL=https://tasks.example.com
# BOT_OWNER_USER_ID=
# OPS_ALLOWLIST_USER_IDS=
# DISCORD_PREMIUM_SKU_IDS=

# Optional integrations. Supplying both Privy values enables wallets.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Deployment metadata is injected by the release workflow, not hand-configured.
# APP_REVISION=
# PREVIOUS_APP_REVISION=
# RELEASE_NOTES_CHANNEL_ID=
# POD_NAMESPACE=
# SANDBOX_IMAGE=
