# Generated from src/config/environment.ts. Run npm run config:docs after changing the manifest.
# Stable models, limits, repository identity, and product behavior live in src/config/env.ts.

# Required application credentials and identity
# Discord bot token. Required for: Discord bot and worker roles.
DISCORD_TOKEN=
# Discord application ID. Required for: Discord bot, worker, and hosted Console roles.
DISCORD_CLIENT_ID=
# Discord OAuth client secret. Required for: hosted Console authentication.
DISCORD_CLIENT_SECRET=
# Private community guild ID. Required for: Discord bot, worker, and hosted Console roles.
DISCORD_GUILD_ID=
# Postgres connection string with pgvector available. Required for: all roles.
DATABASE_URL=postgres://discord_ai_agent:discord_ai_agent@localhost:5433/discord_ai_agent
# OpenRouter credential for model and provider-backed tools. Required for: agent execution.
OPENROUTER_API_KEY=
# HMAC secret for hosted Console sessions and OAuth state. Required for: hosted Console authentication.
CONSOLE_SESSION_SECRET=

# Operator access and protected capabilities
# Discord user ID with owner authority. Required for: owner-only mutations.
# BOT_OWNER_USER_ID=
# Comma-separated Discord user IDs with operations authority. Required for: restricted operations.
# OPS_ALLOWLIST_USER_IDS=

# Optional integrations (supply complete credential pairs)
# Privy application ID; supplying both Privy values enables wallets. Required for: wallets.
# PRIVY_APP_ID=
# Privy application secret; supplying both Privy values enables wallets. Required for: wallets.
# PRIVY_APP_SECRET=

# Injected deployment metadata (do not hand-configure locally)
# Node runtime mode. Required for: runtime platform.
# NODE_ENV=production
# Immutable deployed git revision. Required for: release workflow.
# APP_REVISION=
# Unique public identifier for this rollout's post-deploy promotion. Required for: release workflow.
# RELEASE_VERIFICATION_ID=
# Previously deployed git revision. Required for: release announcements.
# PREVIOUS_APP_REVISION=
