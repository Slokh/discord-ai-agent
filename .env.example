# Generated from src/config/environment.ts. Run npm run config:docs after changing the manifest.
# Stable models, limits, repository identity, and product behavior live in src/config/env.ts.

# Required application credentials and identity
# Discord bot token. Required for: Discord bot and worker roles.
DISCORD_TOKEN=
# Discord application ID. Required for: Discord bot and worker roles.
DISCORD_CLIENT_ID=
# Private community guild ID. Required for: Discord bot and worker roles.
DISCORD_GUILD_ID=
# Postgres connection string with pgvector available. Required for: all roles.
DATABASE_URL=postgres://discord_ai_agent:discord_ai_agent@localhost:5433/discord_ai_agent
# OpenRouter credential for model and provider-backed tools. Required for: agent execution.
OPENROUTER_API_KEY=
# Shared HMAC secret for isolated task callbacks. Required for: code updates.
TASK_SIGNING_SECRET=

# GitHub publication (choose token or complete App credentials)
# GitHub token used for code-update publication when an App is not configured. Required for: code updates (token mode).
# GITHUB_TOKEN=
# GitHub App ID. Required for: code updates (App mode).
# GITHUB_APP_ID=
# GitHub App private key. Required for: code updates (App mode).
# GITHUB_APP_PRIVATE_KEY=
# GitHub App installation ID. Required for: code updates (App mode).
# GITHUB_APP_INSTALLATION_ID=

# Operator access and protected capabilities
# Password protecting the run console and metrics endpoint. Required for: public control API.
# CONTROL_UI_AUTH_PASSWORD=
# Externally routed HTTPS URL for task/run links. Required for: public control API.
# CONTROL_UI_PUBLIC_URL=https://tasks.example.com
# Discord user ID with owner authority. Required for: owner-only mutations.
# BOT_OWNER_USER_ID=
# Comma-separated Discord user IDs with operations authority. Required for: restricted operations.
# OPS_ALLOWLIST_USER_IDS=
# Comma-separated configured Discord premium SKU IDs. Required for: premium buttons.
# DISCORD_PREMIUM_SKU_IDS=

# Optional integrations (supply complete credential pairs)
# Spotify application client ID. Required for: Spotify tools.
# SPOTIFY_CLIENT_ID=
# Spotify application client secret. Required for: Spotify tools.
# SPOTIFY_CLIENT_SECRET=
# Privy application ID; supplying both Privy values enables wallets. Required for: wallets.
# PRIVY_APP_ID=
# Privy application secret; supplying both Privy values enables wallets. Required for: wallets.
# PRIVY_APP_SECRET=

# Injected deployment metadata (do not hand-configure locally)
# Node runtime mode. Required for: runtime platform.
# NODE_ENV=production
# Immutable deployed git revision. Required for: release workflow.
# APP_REVISION=
# Unique public identifier for this rollout's post-deploy promotion. Required for: release workflow.
# RELEASE_VERIFICATION_ID=
# Previously deployed git revision. Required for: release announcements.
# PREVIOUS_APP_REVISION=
# Discord channel receiving deployment announcements. Required for: release announcements.
# RELEASE_NOTES_CHANNEL_ID=
# Namespace where isolated code-update Jobs are created. Required for: Kubernetes worker.
# POD_NAMESPACE=
# Immutable code-update sandbox image reference. Required for: Kubernetes worker.
# SANDBOX_IMAGE=
