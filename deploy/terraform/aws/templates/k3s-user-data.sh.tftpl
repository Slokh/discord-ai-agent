#!/usr/bin/env bash
set -euo pipefail

dnf install -y gzip jq tar util-linux xfsprogs

install -d -m 0755 /usr/local/bin /usr/local/sbin /etc/discord-ai-agent /var/lib/discord-ai-agent/postgres-volume

curl -fsSL "https://github.com/k3s-io/k3s/releases/download/${k3s_version}/k3s" -o /tmp/k3s
printf '%s  %s\n' '${k3s_binary_sha256}' /tmp/k3s | sha256sum --check --status
install -m 0755 /tmp/k3s /usr/local/bin/k3s
rm -f /tmp/k3s
ln -sf /usr/local/bin/k3s /usr/local/bin/kubectl
ln -sf /usr/local/bin/k3s /usr/local/bin/crictl

curl -fsSL "https://get.helm.sh/helm-${helm_version}-linux-amd64.tar.gz" -o /tmp/helm.tar.gz
printf '%s  %s\n' '${helm_archive_sha256}' /tmp/helm.tar.gz | sha256sum --check --status
tar -xzf /tmp/helm.tar.gz -C /tmp
install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm
rm -rf /tmp/helm.tar.gz /tmp/linux-amd64

cat >/etc/discord-ai-agent/runtime.env <<'EOF'
AWS_REGION=${aws_region}
KUBERNETES_NAMESPACE=${kubernetes_namespace}
ECR_REGISTRY=${ecr_registry}
K3S_STATE_VOLUME_ID=${k3s_state_volume_id}
POSTGRES_VOLUME_ID=${postgres_volume_id}
APPLICATION_SECRET_ARN=${application_secret_arn}
POSTGRES_SECRET_ARN=${postgres_secret_arn}
AGENT_JOIN_SECRET_ARN=${agent_join_secret_arn}
SANDBOX_AUTOSCALING_GROUP=${sandbox_autoscaling_group}
EOF
chmod 0600 /etc/discord-ai-agent/runtime.env

cat >/usr/local/sbin/discord-ai-agent-mount-volume <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
volume_id="$1"
mount_point="$2"
allow_format="$3"
attachment_device="$4"
source /etc/discord-ai-agent/runtime.env

token="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' http://169.254.169.254/latest/api/token)"
instance_id="$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)"

while true; do
  attachment="$(aws ec2 describe-volumes --region "$AWS_REGION" --volume-ids "$volume_id" --query 'Volumes[0].Attachments[0].InstanceId' --output text)"
  state="$(aws ec2 describe-volumes --region "$AWS_REGION" --volume-ids "$volume_id" --query 'Volumes[0].State' --output text)"
  if [ "$attachment" = "$instance_id" ]; then
    break
  fi
  if [ "$state" = "available" ] || [ "$attachment" = "None" ]; then
    aws ec2 attach-volume --region "$AWS_REGION" --volume-id "$volume_id" --instance-id "$instance_id" --device "$attachment_device" >/dev/null || true
  fi
  sleep 10
done

serial="$${volume_id//-/}"
device=""
for _ in $(seq 1 60); do
  device="$(lsblk -ndo NAME,SERIAL | awk -v serial="$serial" '$2 == serial { print "/dev/" $1; exit }')"
  [ -n "$device" ] && break
  sleep 2
done
[ -n "$device" ]

if ! blkid "$device" >/dev/null 2>&1; then
  if [ "$allow_format" != "yes" ]; then
    echo "Refusing to format durable volume $volume_id." >&2
    exit 1
  fi
  mkfs.ext4 -F "$device" >/dev/null
fi

install -d -m 0755 "$mount_point"
mountpoint -q "$mount_point" || mount "$device" "$mount_point"
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-mount-volume

cat >/usr/local/sbin/discord-ai-agent-bootstrap-secrets <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source /etc/discord-ai-agent/runtime.env
for _ in $(seq 1 60); do
  /usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null 2>&1 && break
  sleep 2
done
/usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null
/usr/local/bin/k3s kubectl create namespace "$KUBERNETES_NAMESPACE" --dry-run=client -o yaml | /usr/local/bin/k3s kubectl apply -f - >/dev/null

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
chmod 0700 "$temporary"
aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$APPLICATION_SECRET_ARN" --query SecretString --output text >"$temporary/application.json"
aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$POSTGRES_SECRET_ARN" --query SecretString --output text >"$temporary/postgres.json"
chmod 0600 "$temporary"/*.json
/usr/local/bin/k3s kubectl apply -f "$temporary/application.json" >/dev/null
/usr/local/bin/k3s kubectl apply -f "$temporary/postgres.json" >/dev/null
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-bootstrap-secrets

cat >/usr/local/sbin/discord-ai-agent-refresh-ecr <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source /etc/discord-ai-agent/runtime.env
temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
chmod 0700 "$temporary"
password="$(aws ecr get-login-password --region "$AWS_REGION")"
auth="$(printf 'AWS:%s' "$password" | base64 -w 0)"
jq -n --arg registry "$ECR_REGISTRY" --arg auth "$auth" '{auths:{($registry):{auth:$auth}}}' >"$temporary/config.json"
unset password auth
chmod 0600 "$temporary/config.json"
/usr/local/bin/k3s kubectl --namespace "$KUBERNETES_NAMESPACE" create secret generic discord-ai-agent-ecr \
  --type=kubernetes.io/dockerconfigjson \
  --from-file=.dockerconfigjson="$temporary/config.json" \
  --dry-run=client -o yaml | /usr/local/bin/k3s kubectl apply -f - >/dev/null
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-refresh-ecr

# Sandbox agents join with a short-lived K3s bootstrap token: an agent-only,
# kubeadm-style credential stored as a kube-system Secret. Minting one never
# touches server bootstrap files, so it is safe on the existing cluster; never
# add --token or --agent-token flags to the server unit. The operator installer
# copies this block verbatim, so it must not use template interpolation.
cat >/usr/local/sbin/discord-ai-agent-refresh-agent-join <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source /etc/discord-ai-agent/runtime.env
for _ in $(seq 1 60); do
  /usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null 2>&1 && break
  sleep 2
done
/usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null

temporary="$(mktemp -d)"
created_id=""
cleanup() {
  rm -rf "$temporary"
  if [ -n "$created_id" ]; then
    /usr/local/bin/k3s token delete "$created_id" >/dev/null || true
  fi
}
trap cleanup EXIT
chmod 0700 "$temporary"

token="$(/usr/local/bin/k3s token create --ttl 24h --usages authentication --description sandbox-agent)"
[[ "$token" =~ ^K10[0-9a-f]{64}::[a-z0-9]{6}\.[a-z0-9]{16}$ ]]
created_id="$(printf '%s' "$token" | cut -d: -f3 | cut -d. -f1)"
imds="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' http://169.254.169.254/latest/api/token)"
private_ip="$(curl -fsS -H "X-aws-ec2-metadata-token: $imds" http://169.254.169.254/latest/meta-data/local-ipv4)"
(umask 077 && AGENT_JOIN_TOKEN="$token" jq -n --arg url "https://$private_ip:6443" '{server_url:$url,token:env.AGENT_JOIN_TOKEN}' >"$temporary/join.json")
unset token
aws secretsmanager put-secret-value --region "$AWS_REGION" --secret-id "$AGENT_JOIN_SECRET_ARN" \
  --secret-string "file://$temporary/join.json" >/dev/null
published_id="$created_id"
created_id=""

# Agents re-read the record before every start, so superseded tokens go now;
# the K3s token cleaner also removes any that expire unpublished.
/usr/local/bin/k3s kubectl --namespace kube-system get secrets \
  --field-selector type=bootstrap.kubernetes.io/token -o json \
  | jq -r --arg keep "$published_id" \
    '.items[] | select((.data.description // "" | @base64d) == "sandbox-agent") | .data["token-id"] | @base64d | select(. != $keep)' \
  | while read -r superseded_id; do
    /usr/local/bin/k3s token delete "$superseded_id" >/dev/null
  done
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-refresh-agent-join

# Sandbox agents are disposable spot instances, and nothing deregisters one on
# scale-in or interruption. This removes a sandbox-pool Node, and the K3s
# node-password Secret that would reject the next instance with its hostname,
# once it has been NotReady for ten minutes and no live EC2 instance launched
# before it registered still holds its address. It never selects the server
# node. The operator installer copies this block verbatim, so it must not use
# template interpolation.
cat >/usr/local/sbin/discord-ai-agent-clean-sandbox-nodes <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source /etc/discord-ai-agent/runtime.env
/usr/local/bin/k3s kubectl get nodes --selector discord-ai-agent.dev/pool=sandbox -o json \
  | jq -r '.items[]
    | select(.metadata.name != "discord-ai-agent-production")
    | select(.metadata.labels["node-role.kubernetes.io/control-plane"] == null)
    | ((.status.conditions // []) | map(select(.type == "Ready")) | first) as $ready
    | select(($ready.status // "Unknown") != "True")
    | select(now - (($ready.lastTransitionTime // .metadata.creationTimestamp) | fromdateiso8601) > 600)
    | [.metadata.name, .metadata.creationTimestamp, ((.status.addresses // []) | map(select(.type == "InternalIP")) | first | .address // "")]
    | @tsv' \
  | while IFS=$'\t' read -r node created address; do
    [[ "$address" =~ ^10\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    # Any AWS or date-parsing failure aborts the run before a deletion. An
    # instance that launched after the Node registered reused its address and
    # cannot own it; K3s rejects that instance until the old record is gone.
    owners="$(aws ec2 describe-instances --region "$AWS_REGION" \
      --filters "Name=private-ip-address,Values=$address" 'Name=instance-state-name,Values=pending,running,shutting-down,stopping,stopped' \
      --query 'Reservations[].Instances[].LaunchTime' --output json \
      | jq --arg created "$created" '[.[] | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601 | select(. <= ($created | fromdateiso8601))] | length')"
    [ "$owners" = 0 ] || continue
    /usr/local/bin/k3s kubectl delete node "$node" --ignore-not-found >/dev/null
    /usr/local/bin/k3s kubectl --namespace kube-system delete secret "$node.node-password.k3s" --ignore-not-found >/dev/null
    echo "Removed stale sandbox node $node."
  done
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-clean-sandbox-nodes

# The sandbox pool scales to zero. One pass raises it to one agent while any
# sandbox Job is unfinished or any sandbox pod is not terminal, and lowers it to
# zero after ten minutes with neither. Any Kubernetes or AWS error ends the pass
# before it changes capacity. The operator installer copies this block
# verbatim, so it must not use template interpolation.
cat >/usr/local/sbin/discord-ai-agent-scale-sandbox <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
source /etc/discord-ai-agent/runtime.env
[[ "$SANDBOX_AUTOSCALING_GROUP" =~ ^[A-Za-z0-9_-]+-k3s-sandbox$ ]] || exit 1
idle_file=/var/lib/discord-ai-agent/sandbox-idle-since
idle_seconds=600
selector=app.kubernetes.io/name=discord-ai-agent,app.kubernetes.io/component=sandbox

jobs="$(/usr/local/bin/k3s kubectl get jobs --all-namespaces --selector "$selector" -o json \
  | jq '[.items[] | select([.status.conditions[]? | select((.type == "Complete" or .type == "Failed") and .status == "True")] | length == 0)] | length')"
pods="$(/usr/local/bin/k3s kubectl get pods --all-namespaces --selector "$selector" -o json \
  | jq '[.items[] | select(.status.phase != "Succeeded" and .status.phase != "Failed")] | length')"
desired="$(aws autoscaling describe-auto-scaling-groups --region "$AWS_REGION" \
  --auto-scaling-group-names "$SANDBOX_AUTOSCALING_GROUP" \
  --query 'AutoScalingGroups[0].DesiredCapacity' --output text)"
[[ "$jobs" =~ ^[0-9]+$ && "$pods" =~ ^[0-9]+$ && "$desired" =~ ^[0-9]+$ ]] || exit 1

set_desired() {
  aws autoscaling set-desired-capacity --region "$AWS_REGION" \
    --auto-scaling-group-name "$SANDBOX_AUTOSCALING_GROUP" --desired-capacity "$1" --no-honor-cooldown
}

if [ "$jobs" -gt 0 ] || [ "$pods" -gt 0 ]; then
  rm -f "$idle_file"
  if [ "$desired" -eq 0 ]; then
    set_desired 1
    echo "Scaled the sandbox pool to 1 for $jobs unfinished sandbox Jobs and $pods active sandbox pods."
  fi
  exit 0
fi
if [ "$desired" -eq 0 ]; then
  rm -f "$idle_file"
  exit 0
fi

now="$(date +%s)"
since="$(cat "$idle_file" 2>/dev/null || true)"
if ! [[ "$since" =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$now" >"$idle_file"
  echo "The sandbox pool is idle; it scales to 0 after 10 idle minutes."
  exit 0
fi
if [ $((now - since)) -ge "$idle_seconds" ]; then
  set_desired 0
  rm -f "$idle_file"
  echo "Scaled the sandbox pool to 0 after $(((now - since) / 60)) idle minutes."
fi
EOF
chmod 0755 /usr/local/sbin/discord-ai-agent-scale-sandbox

cat >/etc/systemd/system/discord-ai-agent-storage.service <<'EOF'
[Unit]
Description=Attach and mount Discord AI Agent production state
Wants=network-online.target
After=network-online.target
Before=k3s.service

[Service]
Type=oneshot
EnvironmentFile=/etc/discord-ai-agent/runtime.env
ExecStart=/usr/local/sbin/discord-ai-agent-mount-volume $K3S_STATE_VOLUME_ID /var/lib/rancher/k3s yes /dev/sdf
ExecStart=/usr/local/sbin/discord-ai-agent-mount-volume $POSTGRES_VOLUME_ID /var/lib/discord-ai-agent/postgres-volume no /dev/sdg
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/k3s.service <<'EOF'
[Unit]
Description=Lightweight Kubernetes
Requires=discord-ai-agent-storage.service
After=discord-ai-agent-storage.service network-online.target

[Service]
Type=notify
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStart=/usr/local/bin/k3s server \
  --node-name=discord-ai-agent-production \
  --node-label=discord-ai-agent.dev/storage=local \
  --disable=traefik \
  --disable=servicelb \
  --disable=local-storage \
  --disable=metrics-server \
  --secrets-encryption \
  --write-kubeconfig-mode=0600

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/discord-ai-agent-bootstrap.service <<'EOF'
[Unit]
Description=Restore Discord AI Agent Kubernetes secrets
Requires=k3s.service
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/discord-ai-agent-bootstrap-secrets
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/discord-ai-agent-ecr-refresh.service <<'EOF'
[Unit]
Description=Refresh the short-lived ECR image-pull credential
Requires=discord-ai-agent-bootstrap.service
After=discord-ai-agent-bootstrap.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/discord-ai-agent-refresh-ecr
EOF

cat >/etc/systemd/system/discord-ai-agent-ecr-refresh.timer <<'EOF'
[Unit]
Description=Refresh ECR image-pull credentials every six hours

[Timer]
OnBootSec=30s
OnUnitActiveSec=6h
Persistent=true
Unit=discord-ai-agent-ecr-refresh.service

[Install]
WantedBy=timers.target
EOF

cat >/etc/systemd/system/discord-ai-agent-agent-join-refresh.service <<'EOF'
[Unit]
Description=Mint and publish the short-lived K3s join record for sandbox agents
Requires=k3s.service
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/discord-ai-agent-refresh-agent-join
EOF

cat >/etc/systemd/system/discord-ai-agent-agent-join-refresh.timer <<'EOF'
[Unit]
Description=Refresh the 24-hour sandbox agent join token every six hours

[Timer]
OnBootSec=1min
OnUnitActiveSec=6h
Unit=discord-ai-agent-agent-join-refresh.service

[Install]
WantedBy=timers.target
EOF

cat >/etc/systemd/system/discord-ai-agent-sandbox-node-cleanup.service <<'EOF'
[Unit]
Description=Remove sandbox agent Nodes whose EC2 instance is gone
# Requisite, not Requires: a cleanup run must never start a stopped K3s server.
Requisite=k3s.service
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/discord-ai-agent-clean-sandbox-nodes
EOF

cat >/etc/systemd/system/discord-ai-agent-sandbox-node-cleanup.timer <<'EOF'
[Unit]
Description=Remove stale sandbox agent Nodes every five minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Unit=discord-ai-agent-sandbox-node-cleanup.service

[Install]
WantedBy=timers.target
EOF

cat >/etc/systemd/system/discord-ai-agent-sandbox-scaler.service <<'EOF'
[Unit]
Description=Scale the sandbox agent pool with sandbox Job demand
# Ordering only: the scaler never starts or stops K3s, and a pass simply fails
# while the API is unavailable.
After=k3s.service

[Service]
Type=simple
ExecStart=/bin/bash -c 'while true; do /usr/local/sbin/discord-ai-agent-scale-sandbox || echo "Sandbox scaler pass failed; it changes capacity only after every check succeeds." >&2; sleep 20; done'
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable discord-ai-agent-storage.service k3s.service discord-ai-agent-bootstrap.service discord-ai-agent-ecr-refresh.timer discord-ai-agent-agent-join-refresh.timer discord-ai-agent-sandbox-node-cleanup.timer discord-ai-agent-sandbox-scaler.service
systemctl start --no-block k3s.service
systemctl start discord-ai-agent-ecr-refresh.timer
systemctl start discord-ai-agent-agent-join-refresh.timer
systemctl start discord-ai-agent-sandbox-node-cleanup.timer
systemctl start --no-block discord-ai-agent-sandbox-scaler.service
